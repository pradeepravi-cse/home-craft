# Copy this to .env and fill in your values
APP_PORT=8080

# Admin user — created automatically on first run (no signup page)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# Database
DB_USER=ppuser
DB_PASSWORD=change-this-password

# JWT
JWT_SECRET=change-this-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend API URL (use /api for same-domain via nginx)
VITE_API_URL=/api

# Your contact info (used in public pages)
WHATSAPP_NUMBER=+60xxxxxxxx
INSTAGRAM_HANDLE=XXXXXXXXX
