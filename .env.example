# ── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8080               # External port exposed by nginx (docker)
NODE_ENV=development        # development | production
APP_NAME=HomeCraft           # Displayed in the UI and outgoing emails (backend)
VITE_APP_NAME=HomeCraft      # Same value — Vite exposes VITE_* to the browser bundle
VITE_APP_TAGLINE=Business Manager

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SCHEMA=public            # PostgreSQL schema — use "public" for prod, e.g. "dev-db" for local

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ── Admin seed account (created automatically on first run) ───────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=/api           # /api for same-domain nginx proxy | http://localhost:3001 for local dev
APP_URL=https://your-app.example.com  # Full public URL of the frontend — used in password reset & invite emails

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Required for password reset and user invite emails.
# Supports any SMTP provider (Gmail, Outlook, Brevo, Mailgun, etc.).
# Leave SMTP_HOST blank and emails will not be sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false           # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=you@example.com
SMTP_PASS=your-app-password # Gmail: generate an App Password — never use your account password
FROM_EMAIL=you@example.com  # Displayed as the sender address in outgoing emails

# ── Contact info ──────────────────────────────────────────────────────────────
WHATSAPP_NUMBER=+60xxxxxxxxxx
INSTAGRAM_HANDLE=yourhandle
