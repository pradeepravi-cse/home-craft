# ── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8080               # External port exposed by nginx (docker)
NODE_ENV=development        # development | production

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=ppuser
DB_PASSWORD=change-this-password
DATABASE_URL=postgresql://ppuser:change-this-password@localhost:5432/homecraft

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ── Admin seed account (created automatically on first run) ───────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=/api           # /api for same-domain nginx proxy | http://localhost:3000 for local dev
                            # Cloud deploy: set to https://your-app.koyeb.app (no trailing slash)

# ── Contact info (used in public-facing pages) ────────────────────────────────
WHATSAPP_NUMBER=+60xxxxxxxxxx
INSTAGRAM_HANDLE=yourhandle
